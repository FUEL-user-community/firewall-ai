# ══════════════════════════════════════════════════════════════
# NEO — Symbiotic SSH + XML-API Resident Configuration
# ══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ══════════════════════════════════════════════════════════════

# --- Required API Keys (Consumed once into _SEALED_VAULT & purged from os.environ) ---
GEMINI_API_KEY=your-gemini-api-key-here
PANOS_API_KEY=your-panos-api-key-here
# Optional per-device keys matching config/devices.yaml aliases:
# PANOS_API_KEY_FW_HQ=your-panos-api-key-here

# --- Default Firewall Target ---
PANOS_HOSTNAME=192.168.1.254
# Default SSH username for `python3 neo_cli.py --ssh fw-hq`:
# PANOS_SSH_USER=admin
# Set to 'false' only in lab environments with self-signed certs (prefer ssl_fingerprint in devices.yaml):
# PANOS_VERIFY_SSL=true

# --- Gemini Model Selection ---
GEMINI_MODEL=gemini-3.1-pro-preview
FLASH_MODEL=gemini-2.5-flash

# --- Google Drive Reference Airlock & Stigmergic Commons (Optional) ---
# Service account JSON (for Workspace / read-only folders) OR personal OAuth token JSON (for Google AI Ultra Sparks Drive write):
# GCP_SERVICE_ACCOUNT_FILE=config/gcp-service-account.json
# GOOGLE_OAUTH_TOKEN_FILE=config/gdrive_token.json
# Folder IDs for PAN-OS reference PDFs and NEO <-> Gemini Spark stigmergic board:
# KNOWLEDGE_BASE_FOLDER_ID=
# DRIVE_BOARD_FOLDER_ID=

# --- Optional Live Documentation Research (Google Custom Search) ---
# GOOGLE_SEARCH_API_KEY=
# GOOGLE_CSE_ID=

# --- Budget & Safety Governance (Optional) ---
# BUDGET_PER_INVESTIGATION=2.00
# BUDGET_PER_DAY=20.00
# POLICY_MODE=READ_ONLY
# SCRUB_PII=false
# SANITIZER_SEED=

# --- Optional Enterprise Secrets Backend (default: dotenv) ---
# SECRETS_BACKEND=vault
# VAULT_ADDR=http://localhost:8200
# VAULT_ROLE_ID=your-role-id
# VAULT_SECRET_ID=your-secret-id
# VAULT_SECRET_PATH=core-defense

# SHA-256 prompt integrity pin (auto-read from .env.example if omitted in .env)
PROMPTS_YAML_SHA=03e7bf98adb8de05218b38821b301cb49d179ffd5697607f451b9e90f3ce7624
