# ══════════════════════════════════════════════════════════════
# CORE DEFENSE — Environment Configuration
# ══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ══════════════════════════════════════════════════════════════

# --- YOUR API KEYS (Required) ---
GEMINI_API_KEY=your-gemini-api-key-here
PANOS_API_KEY=your-panos-api-key-here
# For Live Documentation Research Tool (Optional):
# GOOGLE_SEARCH_API_KEY=your-google-search-api-key-here
# GOOGLE_CSE_ID=your-custom-search-engine-id

# --- Your Firewall (Required) ---
PANOS_HOSTNAME=192.168.1.254
# Set to 'false' if using self-signed certs in a lab
# PANOS_VERIFY_SSL=true


# --- Simple Set-Up for .env enabled server access
# --- generated at first-runtime
API_ACCESS_KEY=


# --- Gemini Model Selection ---
GEMINI_MODEL=gemini-3.1-pro-preview
FLASH_MODEL=gemini-3.6-flash
# Set to 'true' to enable the Gemini Flash Debate Auditor (default: false)
AUDITOR_ENABLED=false

# --- Google Drive & Obsidian Integration (Optional) ---
# Path to your Google Cloud Service Account JSON credentials file
GCP_SERVICE_ACCOUNT_FILE=config/gcp-service-account.json
# The ID of the Google Drive folder where you want to sync your Obsidian Vault
OBSIDIAN_DRIVE_FOLDER_ID=your-google-drive-folder-id-here

# ══════════════════════════════════════════════════════════════
# That's it! The above is all you need to get started.
# Run: python server.py
# Open: http://localhost:8888
# ══════════════════════════════════════════════════════════════

# --- Advanced: Autonomous Defense Deck (Optional) ---
# Set to 'true' to enable background card scheduler daemon (default: false)
# CARD_ENGINE_ENABLED=false

# --- Advanced: Budget & Cost Limits (Optional) ---
# When analyzing large custom firewall XML configurations, token usage scales with config size.
# Set spending caps per investigation and per day (in USD):
# BUDGET_PER_INVESTIGATION=2.00
# BUDGET_PER_DAY=20.00
# CARD_BUDGET_PER_RUN=1.00
# CARD_BUDGET_PER_DAY=10.00

# --- Advanced: Policy & Safety (Optional) ---
# Default is 'READ_ONLY'. Set to 'READ_WRITE' to enable state-modifying tools
# (e.g., quarantine IPs, clear active sessions, edit tags).
# POLICY_MODE=READ_ONLY
# Set to 'false' to disable PII scrubbing and send raw IP addresses to the LLM.
# SCRUB_PII=false

# --- Advanced: Secrets Backend (Optional) ---
# Default is 'dotenv' (reads from this file). For enterprise use:
# SECRETS_BACKEND=vault
# VAULT_ADDR=http://localhost:8200
# VAULT_ROLE_ID=your-role-id
# VAULT_SECRET_ID=your-secret-id
# VAULT_SECRET_PATH=core-defense
